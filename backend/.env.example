# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_in_production

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://arbiter:arbiter@localhost:5432/arbiter

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vault / Encryption ────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=your_fernet_key_here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production

# ── OAuth2 / SSO ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Email (Resend HTTP API) ────────────────────────────────────────────────────
# Required for email verification, password reset, and org invites.
# Get a free API key at https://resend.com (3k emails/month free)
# Using HTTP API instead of SMTP. Railway and most cloud platforms block outbound SMTP.
RESEND_API_KEY=re_...
EMAIL_FROM=support@arbiterai.dev
EMAIL_FROM_NAME=Arbiter
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_CHANGE_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ── Registration ───────────────────────────────────────────────────────────────
ALLOW_PUBLIC_REGISTRATION=true
# Set to false + provide INVITE_CODE for closed beta / invite-only mode
INVITE_CODE=

# ── CORS (comma-separated) ─────────────────────────────────────────────────────
# Production: set to your Vercel frontend URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OpenTelemetry tracing (optional, off by default) ──────────────────────────
# See docs/observability.md. Needs both OTEL_ENABLED=true and an OTLP endpoint.
# The OTEL_EXPORTER_* / OTEL_SERVICE_NAME vars are read by the OTel SDK from the
# process environment. docker compose's env_file exports them; with a bare
# `uvicorn` run, export them in your shell.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<api-key>
OTEL_SERVICE_NAME=arbiter-gateway
# Opt-in: record tool arguments/results on spans (may contain sensitive data)
OTEL_CAPTURE_TOOL_CONTENT=false
